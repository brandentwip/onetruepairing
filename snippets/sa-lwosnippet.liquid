							  jsonpCallback: 'generateloginOTP',
							  contentType: 'application/json',
							  dataType: 'jsonp',
							  data:
								  {
									  action : 'generateotp',
									  shop: 'iktarabanaras.myshopify.com',
									  mobileno: phone_no
								  },
							  success: function (data) {
								  
								  var resp =  data;
								  if(resp.status=='success')
								  {
									 sa_jq('.sa_login_otp_submit' ).off().on( 'click', verifyLoginOtp );
