{%- liquid
  assign collection = section.settings.collection
  assign ratio = section.settings.image_ratio
-%}

<style>
  #na-{{ section.id }} {
    --na-cols: {{ section.settings.columns_desktop }};
    --na-cols-md: {{ section.settings.columns_tablet }};
    --na-cols-sm: {{ section.settings.columns_mobile }};
    --na-bg: {{ section.settings.card_bg }};
    --na-line: {{ section.settings.border_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    margin: 0;
    box-sizing: border-box;
  }
  #na-{{ section.id }} *,
  #na-{{ section.id }} *::before,
  #na-{{ section.id }} *::after { box-sizing: border-box; }

  #na-{{ section.id }} .na__heading {
    margin: 0 0 8px;
    padding: 0 {{ section.settings.side_padding }}px;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-align: {{ section.settings.heading_align }};
  }

  #na-{{ section.id }} .na__grid {
    display: grid;
    grid-template-columns: repeat(var(--na-cols), minmax(0, 1fr));
    margin: 0 {{ section.settings.side_padding }}px;
    border-top: 1px solid var(--na-line);
    border-left: 1px solid var(--na-line);
  }

  #na-{{ section.id }} .na__card {
    display: block;
    color: inherit;
    text-decoration: none;
    border-right: 1px solid var(--na-line);
    border-bottom: 1px solid var(--na-line);
    background: #fff;
  }

  #na-{{ section.id }} .na__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: {{ ratio }};
    background: var(--na-bg);
    overflow: hidden;
  }
  #na-{{ section.id }} .na__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center top;
    transition: opacity .35s ease;
  }
  #na-{{ section.id }} .na__media img.na__img--hover { opacity: 0; }
  #na-{{ section.id }} .na__card:hover .na__img--hover { opacity: 1; }

  #na-{{ section.id }} .na__info {
    padding: 8px 6px 10px;
    text-align: center;
    line-height: 1.3;
  }
  #na-{{ section.id }} .na__title {
    display: block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  #na-{{ section.id }} .na__price {
    display: block;
    margin-top: 2px;
    font-size: 10px;
    color: #666;
  }
  #na-{{ section.id }} .na__price s { margin-left: 4px; opacity: .6; }

  #na-{{ section.id }} .na__more {
    text-align: center;
    margin-top: 24px;
  }
  #na-{{ section.id }} .na__more a {
    display: inline-block;
    padding: 12px 32px;
    border: 1px solid currentColor;
    color: inherit;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
    text-decoration: none;
  }

  @media (max-width: 991px) {
    #na-{{ section.id }} .na__grid { grid-template-columns: repeat(var(--na-cols-md), minmax(0, 1fr)); }
  }
  @media (max-width: 575px) {
    #na-{{ section.id }} .na__grid { grid-template-columns: repeat(var(--na-cols-sm), minmax(0, 1fr)); }
  }
</style>

<section id="na-{{ section.id }}" data-section-id="{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="na__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- liquid
    assign use_blocks = false
    assign total = 0
    if section.blocks.size > 0
      assign use_blocks = true
      assign total = section.blocks.size
    elsif collection != blank
      assign total = section.settings.products_to_show
    endif
  -%}

  {%- if total > 0 -%}
    <div class="na__grid">
      {%- for i in (1..total) -%}
        {%- assign idx = i | minus: 1 -%}
        {%- if use_blocks -%}
          {%- assign product = section.blocks[idx].settings.product -%}
        {%- else -%}
          {%- assign product = collection.products[idx] -%}
        {%- endif -%}
        {%- if product == blank -%}{%- continue -%}{%- endif -%}
        {%- assign main_image = product.featured_image -%}
        {%- if use_blocks and section.blocks[idx].settings.custom_image != blank -%}
          {%- assign main_image = section.blocks[idx].settings.custom_image -%}
        {%- endif -%}
        <a href="{{ product.url }}" class="na__card" {% if use_blocks %}{{ section.blocks[idx].shopify_attributes }}{% endif %}>
          <span class="na__media">
            {%- if main_image -%}
              {{
                main_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 450, 600, 900',
                  sizes: '(min-width: 992px) calc(100vw / var(--na-cols)), (min-width: 576px) 50vw, 100vw',
                  alt: main_image.alt | default: product.title
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}

            {%- if section.settings.hover_image and product.images.size > 1 -%}
              {{
                product.images[1]
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 450, 600, 900',
                  class: 'na__img--hover',
                  alt: product.images[1].alt
              }}
            {%- endif -%}
          </span>

          <span class="na__info">
            <span class="na__title">{{ product.title }}</span>
            {%- if section.settings.show_price -%}
              <span class="na__price">
                {{ product.price | money_without_trailing_zeros }}
                {%- if product.compare_at_price > product.price -%}
                  <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>
                {%- endif -%}
              </span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank -%}
      <div class="na__more">
        <a href="{{ collection.url }}">{{ section.settings.view_all_label }}</a>
      </div>
    {%- endif -%}
  {%- else -%}
    <p style="padding: 0 {{ section.settings.side_padding }}px;">Add Product blocks (or select a collection) in the section settings.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "New Arrivals Grid",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop New Arrivals" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "collection", "id": "collection", "label": "Collection (only used if no Product blocks are added)" },
    { "type": "range", "id": "products_to_show", "min": 3, "max": 24, "step": 1, "label": "Products to show", "default": 6 },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "checkbox", "id": "hover_image", "label": "Show second image on hover", "default": false },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' button", "default": false },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns (desktop)", "default": 3 },
    { "type": "range", "id": "columns_tablet", "min": 1, "max": 4, "step": 1, "label": "Columns (tablet)", "default": 2 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "label": "Columns (mobile)", "default": 2 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "5 / 9", "label": "Tall (model shots)" },
        { "value": "2 / 3", "label": "Portrait 2:3" },
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "1 / 1", "label": "Square" }
      ],
      "default": "5 / 9"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Fill (crop)" },
        { "value": "contain", "label": "Fit (no crop)" }
      ],
      "default": "cover"
    },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "card_bg", "label": "Image background", "default": "#f7f3ea" },
    { "type": "color", "id": "border_color", "label": "Grid line color", "default": "#e5e5e5" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "side_padding", "min": 0, "max": 80, "step": 5, "unit": "px", "label": "Side padding", "default": 25 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Padding bottom", "default": 40 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image",
          "info": "Optional. Upload a separate image; if empty, the product's main image is used."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Arrivals Grid",
      "category": "Collection",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
